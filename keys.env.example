# RedAgent Configuration Template
# Copy this file to keys.env and fill in your values.

# Telegram Alert Bot (For real-time Call option trade signals)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# CryptoPanic API (For Stage-1 breaking news radar & circuit breakers)
CRYPTOPANIC_API_KEY="your_cryptopanic_api_key_here"

# Deribit API Credentials (Optional - public endpoints used for scanning)
DERIBIT_CLIENT_ID=""
DERIBIT_CLIENT_SECRET=""

# Binance API Credentials (Optional - public endpoints used for scanning)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
